# Dear server local environment template.
# Copy to `.env` (gitignored) and fill in real values.

# NOTE: 값에 `&`가 있으면 shell `source` 시 잘려나가므로 반드시 따옴표로 감싼다.
DEAR_DB_URL="jdbc:mysql://localhost:3306/dear?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8"
DEAR_DB_USERNAME=dear
DEAR_DB_PASSWORD=changeme
DEAR_SERVER_PORT=8080

# Hibernate SQL logging: WARN | INFO | DEBUG | TRACE
HIBERNATE_SQL_LEVEL=WARN

# Spring profile: local | prod
SPRING_PROFILES_ACTIVE=local
